{
  "name": "seria",
  "version": "0.1.0",
  "private": true,
  "description": "Adult animated vertical Shorts series (working title) - Remotion code-first pipeline",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "bash tools/still.sh",
    "render:frames": "bash tools/render_frames.sh",
    "render:audio": "bash tools/render_audio.sh",
    "master:audio": "bash tools/master_audio.sh",
    "export": "bash tools/export.sh",
    "check": "bash tools/check_loop.sh",
    "qa": "bash tools/contact_sheet.sh",
    "qa:stills": "node tools/qa_stills.mjs",
    "lint": "tsc --noEmit -p . && tsx src/lint/run.ts",
    "lint:dev": "tsc --noEmit -p . && tsx src/lint/run.ts --dev",
    "typecheck": "tsc --noEmit -p .",
    "preview": "bash tools/preview.sh",
    "qc": "bash tools/qc.sh",
    "new-episode": "bash tools/new_episode.sh"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
